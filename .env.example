# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Your real WhatsApp number, no + or spaces, e.g. 9779800000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Phase 3: Real admin authentication (NextAuth.js) ---
# A random secret used to sign login sessions. Generate one with:
#   openssl rand -base64 32
# (or use any long random string). Required — sessions won't work without it.
NEXTAUTH_SECRET=

# The public URL of the site (http://localhost:3000 locally). Needed so
# NextAuth issues secure cookies and rejects redirects to other sites.
NEXTAUTH_URL=http://localhost:3000

# One-time secret required to create the FIRST admin at /admin/setup
# (stops a stranger claiming the account before you do). Generate with
#   openssl rand -base64 24
# Enter it on the setup page; you can delete it afterwards. In production,
# setup is refused unless this is set.
SETUP_TOKEN=

# OPEN | BUSY | CLOSED — shown as the shop status badge only until a
# database is connected; after that, change it live from the admin
# dashboard instead (Phase 4).
NEXT_PUBLIC_SHOP_STATUS=OPEN

# --- SEO & Domain ---
# Your custom domain (e.g. https://tiaflowershop.online).
# Used in page titles, sitemap.xml, robots.txt, social previews, and schema.org markup.
NEXT_PUBLIC_SITE_URL=https://tiaflowershop.online

# --- Google ---
# Google Business Profile ID (from https://business.google.com)
# Used for local SEO and knowledge panel
NEXT_PUBLIC_GOOGLE_BUSINESS_ID=

# Google Search Console verification code (from google.com/webmasters)
# Add to <meta name="google-site-verification" content="..." />
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Social media links shown in footer + schema.org markup ---
# Format: Full URL (e.g. https://instagram.com/tiaflowershop)
# Leave blank to hide that link — no code changes needed.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Business Info (shown in schema.org markup for local SEO) ---
# Shop address (improves local search ranking)
NEXT_PUBLIC_SHOP_ADDRESS=Near Tribhuvan International Airport, Kathmandu, Nepal
# Shop location (latitude,longitude) for Google Maps
NEXT_PUBLIC_SHOP_LATITUDE=27.8176
NEXT_PUBLIC_SHOP_LONGITUDE=85.9124

# --- WhatsApp Notifications (Optional - Twilio) ---
# To send WhatsApp order notifications to admins:
# 1. Sign up at https://www.twilio.com
# 2. Enable WhatsApp in Twilio Console
# 3. Get your Account SID, Auth Token, and WhatsApp number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155552671

# Admin email for order notifications.
# Server-only on purpose: variables starting with NEXT_PUBLIC_ are shipped to
# every visitor's browser, so this must NOT carry that prefix.
ADMIN_EMAIL=prashant@example.com

# --- Phase 2: MongoDB ---
# Connection string from MongoDB Atlas (mongodb.com/cloud/atlas).
# Leave blank to keep using the mock data in lib/data.ts.
MONGODB_URI=

# --- Phase 2: Image uploads (admin "Manage bouquets" page) ---
# Created automatically when you add a Blob store in Vercel:
# Vercel Dashboard -> your project -> Storage -> Create Database -> Blob
# New stores use OIDC auth (BLOB_STORE_ID) by default — you generally
# don't need to set anything here manually, this is just for reference.
BLOB_READ_WRITE_TOKEN=
