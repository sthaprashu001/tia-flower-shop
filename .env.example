# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Your real WhatsApp number, no + or spaces, e.g. 9779800000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Shared password for /admin/login — no longer used (Phase 3: replaced
# by real per-person logins via NextAuth, see NEXTAUTH_SECRET below).
# Safe to delete this from Vercel once you've confirmed the new login works.
ADMIN_API_KEY=

# --- Phase 3: Real admin authentication (NextAuth.js) ---
# A random secret used to sign login sessions. Generate one with:
#   openssl rand -base64 32
# (or use any long random string). Required — sessions won't work without it.
NEXTAUTH_SECRET=

# OPEN | BUSY | CLOSED — shown as the shop status badge only until a
# database is connected; after that, change it live from the admin
# dashboard instead (Phase 4).
NEXT_PUBLIC_SHOP_STATUS=OPEN

# --- SEO ---
# Your real domain once you buy one (e.g. https://tiaflowershop.com.np).
# Used in page titles, sitemap.xml, robots.txt, and shared-link previews.
# Leave blank to keep using the current tiaflowershop.vercel.app address.
NEXT_PUBLIC_SITE_URL=

# --- Social media links shown in the footer ---
# Leave any of these blank to hide that link — no code changes needed.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Phase 2: MongoDB ---
# Connection string from MongoDB Atlas (mongodb.com/cloud/atlas).
# Leave blank to keep using the mock data in lib/data.ts.
MONGODB_URI=

# --- Phase 2: Image uploads (admin "Manage bouquets" page) ---
# Created automatically when you add a Blob store in Vercel:
# Vercel Dashboard -> your project -> Storage -> Create Database -> Blob
# New stores use OIDC auth (BLOB_STORE_ID) by default — you generally
# don't need to set anything here manually, this is just for reference.
BLOB_READ_WRITE_TOKEN=
